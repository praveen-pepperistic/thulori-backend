# Thulori API — settings template. Copy to .env and fill every blank value:  cp .env.example .env
# Domains assume www / api / admin.thulori.com —
# change them if yours differ.
# The API refuses to start in production until Cashfree, storage and OpenAI keys are set.
# TEAM_EMAIL must be set: payment problems and failed refunds are emailed there.

# ---------- Thulori API configuration ----------
# Copy to .env (never commit .env). Every service has a local "mock/log" driver, so the API
# runs with no outside accounts; switch drivers on as you connect each service.

NODE_ENV=production   # production in live
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/thulori
DATABASE_SSL=true   # true for most managed Postgres (Neon, Supabase, RDS)

SITE_URL=https://www.thulori.com   # the website (site/ folder) — used for CORS and payment return links
API_URL=https://api.thulori.com   # this API's public URL — used for the Cashfree webhook and local file links
ADMIN_URL=https://admin.thulori.com   # the admin panel (admin/ folder), e.g. https://admin.thulori.com
ADMIN_2FA=true                  # admin sign-in emails a 6-digit code (keep true in production)
ADMIN_SESSION_HOURS=12
CORS_ORIGINS=                   # extra allowed site origins, comma separated (e.g. https://www.thulori.com)

# Long random string: openssl rand -base64 48
SESSION_SECRET=                 # long random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_DAYS=30
COOKIE_DOMAIN=.thulori.com   # e.g. .thulori.com when the site is www.thulori.com and the API is api.thulori.com
COOKIE_CROSS_SITE=false         # true only if site and API are on different domains (needs HTTPS)

# ---------- Payments: Cashfree ----------
PAYMENTS_DRIVER=cashfree   # cashfree
CASHFREE_ENV=production   # production
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01

# ---------- Photo storage ----------
STORAGE_DRIVER=s3   # s3 (AWS S3, Cloudflare R2, Wasabi, DigitalOcean Spaces…)
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=auto                  # R2: auto · AWS: ap-south-1
S3_ENDPOINT=                    # R2: https://<account-id>.r2.cloudflarestorage.com · AWS: leave empty
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_MB=25
SIGNED_URL_MINUTES=30

# ---------- AI photo reading: OpenAI ----------
AI_DRIVER=openai   # openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra        # any vision-capable model on your account
AI_BATCH_SIZE=6

# ---------- GST & invoices (confirm the rate and HSN code with your CA) ----------
GST_RATE=18                     # % added at checkout and on invoices
PRICES_INCLUDE_GST=false        # false = listed prices are before GST (as the website says)
INVOICE_PREFIX=TH               # invoice numbers: TH/2026-27/0001
INVOICE_HSN=4911
COMPANY_NAME="Pepperistic Studio Pvt Ltd"
COMPANY_BRAND=Thulori
COMPANY_ADDRESS=                # registered address, printed on invoices
COMPANY_STATE="Tamil Nadu"      # same state as the customer → CGST + SGST, otherwise IGST
COMPANY_GSTIN=
COMPANY_EMAIL=hello@thulori.com
COMPANY_PHONE="+91 97893 90456"

# ---------- Email ----------
NOTIFY_EMAIL=smtp   # smtp
SMTP_URL=                       # smtps://user:pass@smtp.zoho.in:465  (Zoho, SES, Google Workspace, Resend…)
EMAIL_FROM="Thulori <hello@thulori.com>"
TEAM_EMAIL=                     # copies of paid orders + alerts (paid twice, failed refunds) — set this in production

# ---------- WhatsApp (Meta WhatsApp Cloud API) ----------
NOTIFY_WHATSAPP=cloud   # cloud
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=                # permanent System User token
WA_GRAPH_VERSION=v23.0
WA_TEMPLATE_LANG=en
WA_VERIFY_TOKEN=                # any string; also entered in the Meta webhook settings

# Safety net (runs inside the worker)
RECONCILE_SECONDS=60            # how often to re-check open payments and pending refunds with Cashfree
UNPAID_EXPIRY_DAYS=7            # unpaid orders are cancelled after this many days
